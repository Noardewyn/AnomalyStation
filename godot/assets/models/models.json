// The 3D models that replace tg's 2D pictures (docs/ai/specs/models.md). The client reads this file and the .glb files itself (the folder is .gdignore'd, as the
// converted icons are): an entry says which icons (and icon states) a model draws, the rule that picks its parts, where its texture comes from, how its source
// frame fits the world, and its parts. A thing whose icon no entry names keeps its 2D picture.
{
  "models": [
    {
      // Every station airlock shares maintenance.dmi's closed silhouette (the freezer has no windows). The leaves take the door's composed picture, so tg's
      // overlays (the fill or the glass, the lights, the panel, the weld) are drawn on them. Open, each leaf keeps one sprite pixel of its seam in the doorway.
      "id": "station_airlock",
      "icons": [ "icons/obj/doors/airlocks/station/" ],
      "exceptIcons": [ "icons/obj/doors/airlocks/station/overlays.dmi" ],
      "rule": "airlock",
      "texture": "sprite",
      "source": { "width": 2.0, "height": 2.0 },
      "fit": { "width": "tile", "height": "wall" },
      "parts": {
        "left": { "file": "doors/maintenance/maintenance_airlock.glb", "node": "Door_Left", "slide": -0.9375 },
        "right": { "file": "doors/maintenance/maintenance_airlock.glb", "node": "Door_Right", "slide": 0.8125 }
      }
    },
    {
      // The metal table: tg's smoothing junction (table-N) picks a module of the compact kit and turns it; the legs are in the modules. The kit's 0.9 m cell is
      // stretched over the tile and its 0.75 m top brought to the world's table top; the legs keep their proportions.
      "id": "metal_table",
      "icons": [ "icons/obj/smooth_structures/table.dmi" ],
      "rule": "smooth4",
      "texture": "model",
      "source": { "width": 0.9, "height": 0.75 },
      "fit": { "width": "tile", "height": "table" },
      "rigidBelow": 0.72,
      "footprint": 0.8,
      "spriteTop": true,
      "parts": {
        "single": "furniture/metal_table/modular/table_single_4legs.glb",
        "end": "furniture/metal_table/modular/table_end_2legs.glb",
        "straight": "furniture/metal_table/modular/table_top_straight.glb",
        "corner": "furniture/metal_table/modular/table_corner_1leg.glb",
        "cornerOpen": "furniture/metal_table/modular/table_corner_2legs.glb",
        "tee": "furniture/metal_table/modular/table_top_tee.glb",
        "center": "furniture/metal_table/modular/table_top_center.glb"
      }
    },
    {
      // The metal chair, turned by its dir; fitted as the table is (its art is made to the table's 0.75 m), then made larger by "scale" (the owner: half as large again).
      "id": "metal_chair",
      "icons": [ "icons/obj/chairs.dmi" ],
      "states": [ "chair" ],
      "rule": "dir4",
      "texture": "model",
      "source": { "width": 0.9, "height": 0.95 },
      "fit": { "width": "uniform", "height": "table" },
      "scale": 1.5,
      "parts": { "model": "furniture/metal_chair/metal_chair.glb" }
    },
    {
      // tg's metal closets (closets.dm), by the geometry their icon state needs (furniture/metal_locker/variants.json): the body shows the state, the door's front the
      // closet's composed picture while it is shut (the door overlay with the lock lights and the weld) and its door state while it swings, the door's back the
      // state's _back. The door swings as animate_door's, 140 degrees in 0.2 s (the freezer's 123). Things on the tile rest on the shelves found in the body.
