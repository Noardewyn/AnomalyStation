        "doorFront": { "file": "furniture/metal_locker/locker_wardrobe.glb", "node": "Locker_Door", "material": "Atlas_front_", "pivot": true },
        "doorInside": { "file": "furniture/metal_locker/locker_wardrobe.glb", "node": "Locker_Door", "material": "Atlas_inside_", "pivot": true }
