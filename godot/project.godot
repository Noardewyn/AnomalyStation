; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Anomaly Station"
config/description="Anomaly Station client (Godot 4.7.2 mono). Presentation, input, UI and audio only; the simulation is the C# core (docs/ai/specs/apps.md)."
run/main_scene="res://scenes/connect.tscn"
config/project_settings_override="user://first_window.cfg"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
boot_splash/bg_color=Color(0.055, 0.065, 0.085, 1)
boot_splash/show_image=false
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"
config/use_custom_user_dir=true
config/custom_user_dir_name="AnomalyStation"

[audio]

driver/enable_input=true

[autoload]

App="*res://scripts/App.cs"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[dotnet]

project/assembly_name="Anomaly.Client"

[rendering]

textures/vram_compression/import_etc2_astc=true
occlusion_culling/use_occlusion_culling=true

[shader_globals]

anomaly_light_grid={
"type": "sampler2D",
"value": ""
}
anomaly_light_grid_size={
"type": "vec2",
"value": Vector2(1, 1)
}
anomaly_light_grid_origin={
